# Copy to keystore.properties (gitignored) and fill in your values.
# Generate a key: keytool -genkeypair -v -keystore release.keystore -alias bitstream -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=bitstream
keyPassword=YOUR_KEY_PASSWORD
